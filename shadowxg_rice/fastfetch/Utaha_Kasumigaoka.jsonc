{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty",
        "source": "${HOME}/.config/fastfetch/theme_logo.png",
    "width": 20,
    "padding": {
      "top": 3
    }
  },
  "display": {
    "separator": " 󰑃  "
  },
  "modules": [
    "break",
    {
      "type": "os",
      "key": "",
      "keyColor": "magenta"
    },
    {
      "type": "kernel",
      "key": "│ ├",
      "keyColor": "magenta"
    },
    {
      "type": "shell",
      "key": "│ └",
      "keyColor": "magenta"
    },
    "break",
    {
      "type": "wm",
      "key": "",
      "keyColor": "blue"
    },
    {
      "type": "terminal",
      "key": "│ └",
      "keyColor": "blue"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[35m󰗪  \u001b[34m󰗪  \u001b[35m󰗪  "
    }
  ]
}
